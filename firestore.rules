rules_version = '2';

// ===========================================================================
//  BBlade — Firestore rules
//
//  Access model: authentication is provisioned from the members list (see
//  functions/index.js) — self sign-up is disabled and the gateUserSignIn
//  blocking function rejects non-members, stamping { accountId, role } into
//  every allowed user's token (platform staff additionally get platformAdmin).
//  These rules trust those claims:
//
//    - member(account):  any signed-in member of THIS account (tenant isolation)
//    - manager(account): the account's owners/managers
//    - platformAdmin:    BBlade staff — full access across accounts
//
//  Day-to-day venue data (stock, wastage, rota reads) is member-level; account
//  configuration and back-office data (members, venues, sales, deliveries,
//  till mappings, rota writes) is manager-level. Department / with-stock
//  scoping stays client-side for now — those flags live on member docs, not
//  in token claims.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function platformAdmin() {
      return request.auth != null && request.auth.token.platformAdmin == true;
    }
    function member(accountId) {
      return platformAdmin()
        || (request.auth != null && request.auth.token.accountId == accountId);
    }
    function manager(accountId) {
      return platformAdmin()
        || (member(accountId) && request.auth.token.role in ['owner', 'manager']);
    }
    // The account's owners. Narrower than manager() and used only where a
    // setting weakens a control rather than configuring one — turning the
    // tablet's PINs off is the owner's call, not a shift manager's.
    function owner(accountId) {
      return platformAdmin()
        || (member(accountId) && request.auth.token.role == 'owner');
    }
    // A shared bar tablet (a member with the "Tablet account" tick). It stays
    // signed in all night where anyone can reach it, and the person using it is
    // established by a PIN in the app rather than by the login — so it's held
    // out of the stock record below. Everything a shift actually needs
    // (clocking in, wastage, the rota) stays open to it.
    function tabletDevice() {
      return request.auth != null && request.auth.token.tablet == true;
    }
    // True when the member doc being written is the caller's own — matched on
    // email, the same way the app resolves who you are. Only meaningful on
    // reads/writes of an existing doc (it looks at `resource`).
    function ownRecord() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && 'email' in resource.data
        && resource.data.email is string
        && request.auth.token.email.lower() == resource.data.email.lower();
    }

    // Customer account (name, entitlements).
    match /accounts/{accountId} {
      allow read: if member(accountId);
      allow write: if manager(accountId);

      // Staff / members (identity, role, department, feature flags).
      // All members may read (names drive attribution and rota display);
      // only managers may change the staff list.
      //
      // Nobody may delete their own record. Deleting a member revokes their
      // sign-in with it (syncMemberAuth), so a lone owner doing it would lock
      // themselves out of the account with nobody left able to add them back —
      // and there is no restore. The client hides the control; this is what
      // holds if it's bypassed. Platform admins are exempt (they're never
      // deleting their own access to a customer account), and a member with no
      // email has no sign-in to be anybody's own.
      match /members/{memberId} {
        allow read: if member(accountId);
        allow create, update: if manager(accountId);
        allow delete: if platformAdmin()
          || (manager(accountId) && !ownRecord());
      }

      // Staff PINs for the bar tablet — scrypt hashes, no client may touch
      // them. A 4-digit hash that any member could read is 10,000 guesses, so
      // it never leaves the server: the setStaffPin / verifyStaffPin /
      // resetStaffPin callables work through the Admin SDK, which bypasses
      // rules. (The catch-all at the bottom would deny this path anyway —
      // spelling it out is the point.)
      match /memberSecrets/{memberId} {
        allow read, write: if false;
      }

      match /venues/{venueId} {
        allow read: if member(accountId);
        allow write: if manager(accountId);

        // ---- day-to-day staff data ----
        match /stockItems/{itemId} {
          allow read, write: if member(accountId);
        }
        // Staff count; managers keep the record.
        //
        // A completed stock take is the evidence every variance is measured
        // against, so once it's closed nobody below manager may touch it —
        // editing an old count is the cleanest way to make a shortage
        // disappear. Nor may they read it: studying past variances is the
        // groundwork for concealing a future one, and a counter has no need
        // for last month's figures.
        //
        // Members keep everything the job actually requires: start a count,
        // write into it, and close it. Reopening a closed take, deleting one,
        // or amending it afterwards are manager-only.
        //
        // A bar tablet is excluded outright: the stock record is the evidence
        // behind every variance, and an always-on device that anyone can pick
        // up is the wrong thing to hold it open. Counting is done on a
        // person's own login.
        match /stockSessions/{sessionId} {
          allow read: if manager(accountId)
            || (member(accountId) && !tabletDevice() && resource.data.status == 'in_progress');
          allow create: if member(accountId) && !tabletDevice()
            && request.resource.data.status == 'in_progress';
          // Closing a count passes this: the stored document is still open at
          // the moment the rule is evaluated. Editing a closed one does not.
          allow update: if manager(accountId)
            || (member(accountId) && !tabletDevice() && resource.data.status == 'in_progress');
          allow delete: if manager(accountId);
        }
        match /wastageLog/{entryId} {
          allow read, write: if member(accountId);
        }
        // Punch clock — staff clock themselves in/out; managers edit/approve
        // in Timesheets. Backdate approval fields are manager-set but staff
        // create the pending request, so writes stay member-level.
        match /shifts/{shiftId} {
          allow read, write: if member(accountId);
        }
        // Annual-leave requests — staff create their own (pending); managers
        // approve/decline (approval writes A/L onto the rota, which is
        // manager-gated below). Member-level, same model as shifts.
        match /leaveRequests/{requestId} {
          allow read, write: if member(accountId);
        }
        // Shift give-aways & swaps — staff create/claim/accept/cancel their
        // own; managers approve/decline. Applying the result to the rota is
        // the manager-gated rotas write below, so staff can never move shifts
        // themselves. Member-level, same caveat as leaveRequests: per-field
        // guarding stays client-side for now.
        match /shiftRequests/{requestId} {
          allow read, write: if member(accountId);
        }
        match /rotas/{rotaId} {
          allow read: if member(accountId);
          allow write: if manager(accountId);
        }
        match /rotaPrefs/{docId} {
          allow read: if member(accountId);
          allow write: if manager(accountId);
        }
        // Bar tablet settings. Every member reads it (the tablet is signed in
        // as one), but only an owner may change it: `requirePin: false` lets
        // anyone tap any name and act as them, which is a decision about how
        // much the pub's own records are worth, not a shift-level setting.
        match /tabletPrefs/{docId} {
          allow read: if member(accountId);
          allow write: if owner(accountId);
        }

        // ---- owner/manager features ----
        match /deliveryLog/{entryId} {
          allow read, write: if manager(accountId);
        }
        // Cached contribution summary. Readable by every member so staff can
        // see the venue's standing and their own part in it; only managers can
        // write it, because computing it needs the back-office collections
        // above. Contains colleagues' totals — no more sensitive than the
        // member list and wastage attribution, both already member-readable —
        // but the UI still shows non-managers only their own row.
        match /learningProfile/{docId} {
          allow read: if member(accountId);
          allow write: if manager(accountId);
        }
        // Derived consumption rates (usage per week per item). Back-office
        // analytics built from deliveries, so manager-level like its inputs.
        match /itemStats/{itemId} {
          allow read, write: if manager(accountId);
        }
        // What the venue has learned from its delivery notes: supplier item
        // code → stock item, confirmed by a manager during review.
        match /supplierProducts/{productId} {
          allow read, write: if manager(accountId);
        }
        // Scanned delivery notes (proof of delivery + what was read off it).
        // The document image itself is a subdoc, loaded only when opened.
        match /deliveryNotes/{noteId} {
          allow read, write: if manager(accountId);
          match /{sub=**} {
            allow read, write: if manager(accountId);
          }
        }
        match /salesReports/{reportId} {
          allow read, write: if manager(accountId);
        }
        match /tillProducts/{productId} {
          allow read, write: if manager(accountId);
        }
      }
    }

    // Platform config (e.g. platform/config { superAdmins: [...] }). The Cloud
    // Functions read it via the Admin SDK (bypasses rules); this scopes any
    // client access to platform super-admins only.
    match /platform/{docId} {
      allow read, write: if platformAdmin();
    }

    // Shared product catalog — cross-venue lookup that pre-fills category and
    // suggests the size when adding stock. Read-only for every signed-in
    // member; curated by platform staff (reseeded by script) so one venue's
    // typo can't feed suggestions to another.
    match /catalog/{productId} {
      allow read: if request.auth != null;
      allow write: if platformAdmin();
    }

    // Deny anything outside the modelled paths above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
